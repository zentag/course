package frc.robot.subsystems;

import com.ctre.phoenix6.configs.FeedbackConfigs;
import com.ctre.phoenix6.controls.Follower;
import com.ctre.phoenix6.controls.MotionMagicVoltage;
import com.ctre.phoenix6.hardware.TalonFX;
import com.ctre.phoenix6.signals.MotorAlignmentValue;

import edu.wpi.first.wpilibj2.command.SubsystemBase;

public class Intake extends SubsystemBase {

        private final TalonFX intakeRollers = new TalonFX(1);
        private final TalonFX pivotLeader = new TalonFX(2);
        private final TalonFX pivotFollower = new TalonFX(3);
        private final MotionMagicVoltage motionMagicControl = new MotionMagicVoltage(0);

        public Intake () {
                pivotFollower.setControl(new Follower(2,MotorAlignmentValue.Opposed));
                FeedbackConfigs feedbackConfigs = new FeedbackConfigs()
                    .withFeedbackRemoteSensorID(cancoderCANId)
                    .withFeedbackSensorSource(FeedbackSensorSourceValue.RemoteCANcoder)
                    .withRotorToSensorRatio(gearRatioBetweenMotorAndCANcoder); // e.g. 5.0 if motor spins 5x per CANcoder rotation


pivotLeader.getConfigurator().apply(feedbackConfigs);
        }

        @Override
        public void periodic() {
                handleStateTransitions();
                applyState();
        }

        public enum WantedState {
                DEPLOY,
                INTAKE,
                RETRACT,
                HOME
        }

        public enum SystemState {
                DEPLOYING,
                INTAKING,
                RETRACTING,
                HOMING
        }

        public WantedState wantedState = WantedState.DEPLOY;
        private SystemState systemState = SystemState.HOMING;

        private void handleStateTransitions() {
                systemState = switch(wantedState) {
                case DEPLOY -> SystemState.DEPLOYING;
                case INTAKE -> SystemState.INTAKING;
                case RETRACT -> SystemState.RETRACTING;
                case HOME -> SystemState.HOMING;
                };
        }

        private void applyState() {
                switch (systemState) {
                case DEPLOYING -> {
                                pivotLeader.setControl(motionMagicControl.withPosition(0));
                                intakeRollers.set(0);
                        }
                case INTAKING -> {
                                pivotLeader.setControl(motionMagicControl.withPosition(0));
                                intakeRollers.set(0.75);
                        }
                case RETRACTING -> {
                                pivotLeader.setControl(motionMagicControl.withPosition(??);
                        }
                };
        }

}
